<div class="fbl-cf-forge {{#if busy}}is-busy{{/if}}" {{#if busy}}aria-busy="true"{{/if}}>
  {{#if status.text}}
  <div class="fbl-cf-status fbl-cf-status--{{status.type}}" role="status">{{status.text}}</div>
  {{/if}}

  <div class="fbl-cf-forge__main" {{#if busy}}inert{{/if}}>
    <section class="fbl-cf-panel fbl-cf-panel--identity">
      <div class="fbl-cf-section-title">
        <h2><i class="fas fa-signature"></i> {{localize "FBL_CF.Forge.Identity"}}</h2>
        <button type="button" class="fbl-cf-icon-button" data-action="open-diagnostics" data-tooltip="{{localize 'FBL_CF.Diagnostics.Title'}}" aria-label="{{localize 'FBL_CF.Diagnostics.Title'}}">
          <i class="fas fa-stethoscope"></i>
        </button>
      </div>

      <div class="form-group stacked fbl-cf-name-field">
        <label for="{{controlId}}-name">{{localize "FBL_CF.Forge.ActorName"}}</label>
        <div class="form-fields fbl-cf-name-row">
          <input id="{{controlId}}-name" type="text" name="name" value="{{state.name}}" autocomplete="off">
          <button type="button" class="fbl-cf-icon-button" data-action="generate-name" data-tooltip="{{localize 'FBL_CF.Forge.GenerateName'}}" aria-label="{{localize 'FBL_CF.Forge.GenerateName'}}"><i class="fas fa-dice"></i></button>
          <button type="button" class="fbl-cf-icon-button" data-action="suggest-names" data-tooltip="{{localize 'FBL_CF.Forge.SuggestNames'}}" aria-label="{{localize 'FBL_CF.Forge.SuggestNames'}}"><i class="fas fa-list"></i></button>
        </div>
        {{#if resolvedContext}}<p class="hint fbl-cf-context">{{resolvedContext}}</p>{{/if}}
      </div>

      <div class="fbl-cf-field-grid">
        <div class="form-group stacked">
          <label for="{{controlId}}-nameSetKey">{{localize "FBL_CF.Forge.Culture"}}</label>
          <select id="{{controlId}}-nameSetKey" name="nameSetKey">
            {{#each nameSetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group stacked">
          <label for="{{controlId}}-gender">{{localize "FBL_CF.Forge.Gender"}}</label>
          <select id="{{controlId}}-gender" name="gender">
            {{#each genderOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group stacked">
          <label for="{{controlId}}-type">{{localize "FBL_CF.Forge.ActorType"}}</label>
          <select id="{{controlId}}-type" name="type">
            {{#each typeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group stacked">
          <label for="{{controlId}}-folderId">{{localize "FBL_CF.Forge.Folder"}}</label>
          <select id="{{controlId}}-folderId" name="folderId">
            {{#each folderOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      {{#if isCharacter}}
      <div class="fbl-cf-profile-row">
        <label class="fbl-cf-profile-toggle" data-tooltip="{{localize 'FBL_CF.Profile.Hint'}}">
          <input type="checkbox" name="generateProfile" {{#if state.generateProfile}}checked{{/if}}>
          <span>{{localize "FBL_CF.Profile.Generate"}}</span>
        </label>
        <div class="form-group stacked">
          <label for="{{controlId}}-profileRoleKey">{{localize "FBL_CF.Profile.Role"}}</label>
          <select id="{{controlId}}-profileRoleKey" name="profileRoleKey" {{#unless state.generateProfile}}disabled{{/unless}}>
            {{#each profileRoleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group stacked">
          <label for="{{controlId}}-profileTierKey">{{localize "FBL_CF.Profile.Tier"}}</label>
          <select id="{{controlId}}-profileTierKey" name="profileTierKey" {{#unless state.generateProfile}}disabled{{/unless}}>
            {{#each profileTierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>
      {{/if}}

      {{#if suggestions.length}}
      <div class="fbl-cf-suggestions" aria-label="{{localize 'FBL_CF.Forge.SuggestNames'}}">
        {{#each suggestions}}
        <button type="button" class="fbl-cf-chip" data-action="choose-name" data-name="{{name}}" data-gender="{{gender}}" data-set-key="{{setKey}}">{{name}}</button>
        {{/each}}
      </div>
      {{/if}}
    </section>

    <section class="fbl-cf-panel fbl-cf-panel--art {{#unless isCharacter}}is-disabled{{/unless}}">
      <div class="fbl-cf-section-title">
        <h2><i class="fas fa-images"></i> {{localize "FBL_CF.Forge.Art"}}</h2>
        {{#if isCharacter}}
        <label class="fbl-cf-compact-check" data-tooltip="{{localize 'FBL_CF.Forge.AssignArt'}}">
          <input type="checkbox" name="assignArt" {{#if state.assignArt}}checked{{/if}}>
          <span>{{localize "FBL_CF.Forge.UseArt"}}</span>
        </label>
        {{/if}}
      </div>

      {{#if isCharacter}}
      <div class="fbl-cf-field-grid fbl-cf-field-grid--art" {{#unless state.assignArt}}inert{{/unless}}>
        <div class="form-group stacked">
          <label for="{{controlId}}-artSetKey">{{localize "FBL_CF.Forge.ArtSet"}}</label>
          <select id="{{controlId}}-artSetKey" name="artSetKey">
            {{#each artSetOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-group stacked">
          <label for="{{controlId}}-artSubsetKey">{{localize "FBL_CF.Forge.Subset"}}</label>
          <select id="{{controlId}}-artSubsetKey" name="artSubsetKey">
            {{#each subsetOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>

      <div class="fbl-cf-art-workbench">
        <div class="fbl-cf-previews">
          <figure>
            <div class="fbl-cf-preview-frame fbl-cf-preview-frame--portrait"><img src="{{portraitPreview}}" alt="{{localize 'FBL_CF.Forge.Portrait'}}"></div>
            <figcaption>{{localize "FBL_CF.Forge.Portrait"}}</figcaption>
          </figure>
          <figure>
            <div class="fbl-cf-preview-frame fbl-cf-preview-frame--token"><img src="{{tokenPreview}}" alt="{{localize 'FBL_CF.Forge.Token'}}"></div>
            <figcaption>{{localize "FBL_CF.Forge.Token"}}</figcaption>
          </figure>
        </div>

        <div class="fbl-cf-art-actions">
          <button type="button" class="fbl-cf-roll-art" data-action="roll-art" {{#unless state.assignArt}}disabled{{/unless}}><i class="fas fa-dice"></i> {{localize "FBL_CF.Forge.RollArt"}}</button>
          <div class="fbl-cf-icon-strip">
            <button type="button" class="fbl-cf-icon-button" data-action="clear-art" data-tooltip="{{localize 'FBL_CF.Forge.ClearArt'}}" aria-label="{{localize 'FBL_CF.Forge.ClearArt'}}"><i class="fas fa-eraser"></i></button>
            <button type="button" class="fbl-cf-icon-button" data-action="inspect-art" data-tooltip="{{localize 'FBL_CF.Forge.InspectArt'}}" aria-label="{{localize 'FBL_CF.Forge.InspectArt'}}"><i class="fas fa-magnifying-glass"></i></button>
            <button type="button" class="fbl-cf-icon-button" data-action="refresh-art" data-tooltip="{{localize 'FBL_CF.Forge.RefreshIndex'}}" aria-label="{{localize 'FBL_CF.Forge.RefreshIndex'}}"><i class="fas fa-rotate"></i></button>
            <button type="button" class="fbl-cf-icon-button" data-action="reset-used" data-tooltip="{{localize 'FBL_CF.Forge.ResetUsed'}}" aria-label="{{localize 'FBL_CF.Forge.ResetUsed'}}"><i class="fas fa-recycle"></i></button>
          </div>
        </div>
      </div>

      {{#if inspection}}
      <div class="fbl-cf-inspection">
        <dl class="fbl-cf-metrics">
          <div><dt>{{localize "FBL_CF.Diagnostics.Portraits"}}</dt><dd>{{inspection.portraitsAvailable}} / {{inspection.portraitsTotal}}</dd></div>
          <div><dt>{{localize "FBL_CF.Diagnostics.Tokens"}}</dt><dd>{{inspection.tokensAvailable}} / {{inspection.tokensTotal}}</dd></div>
          <div><dt>{{localize "FBL_CF.Diagnostics.Used"}}</dt><dd>{{inspection.usedCount}}</dd></div>
        </dl>
        <p class="hint"><code>{{inspection.folder}}</code></p>
      </div>
      {{/if}}
      {{else}}
      <p class="hint">{{localize "FBL_CF.Forge.ArtCharacterOnly"}}</p>
      {{/if}}
    </section>
  </div>

  <div class="fbl-cf-forge__extras" {{#if busy}}inert{{/if}}>
    <details class="fbl-cf-disclosure fbl-cf-disclosure--token" data-section="prototypeToken" {{#if expanded.prototypeToken}}open{{/if}}>
      <summary><span><i class="fas fa-user-circle"></i> {{localize "FBL_CF.Forge.PrototypeToken"}}</span><i class="fas fa-chevron-down fbl-cf-disclosure__chevron"></i></summary>
      <div class="fbl-cf-disclosure__body">
        <div class="fbl-cf-field-grid">
          <div class="form-group stacked">
            <label for="{{controlId}}-token-name">{{localize "TOKEN.FIELDS.name.label"}}</label>
            <input id="{{controlId}}-token-name" type="text" name="prototypeToken.name" value="{{state.prototypeToken.name}}" placeholder="{{localize 'FBL_CF.Forge.TokenActorName'}}" autocomplete="off">
          </div>
          <div class="form-group stacked" role="group" aria-labelledby="{{controlId}}-token-dimensions">
            <span id="{{controlId}}-token-dimensions">{{localize "TOKEN.Dimensions"}} ({{localize "GridSpaces"}})</span>
            <div class="fbl-cf-field-grid fbl-cf-token-dimensions">
              <input id="{{controlId}}-token-width" type="number" name="prototypeToken.width" min="0" step="any" value="{{state.prototypeToken.width}}" placeholder="{{localize 'DOCUMENT.FIELDS.width.label'}}" aria-label="{{localize 'DOCUMENT.FIELDS.width.label'}}">
              <input id="{{controlId}}-token-height" type="number" name="prototypeToken.height" min="0" step="any" value="{{state.prototypeToken.height}}" placeholder="{{localize 'DOCUMENT.FIELDS.height.label'}}" aria-label="{{localize 'DOCUMENT.FIELDS.height.label'}}">
            </div>
          </div>
          <div class="form-group stacked">
            <label for="{{controlId}}-token-display">{{localize "TOKEN.FIELDS.displayName.label"}}</label>
            <select id="{{controlId}}-token-display" name="prototypeToken.displayName" {{#if tokenDisplay.locked}}disabled aria-describedby="{{controlId}}-token-overrides"{{/if}}>
              {{#each tokenDisplay.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
          <div class="form-group stacked">
            <label for="{{controlId}}-token-disposition">{{localize "TOKEN.FIELDS.disposition.label"}}</label>
            <select id="{{controlId}}-token-disposition" name="prototypeToken.disposition" {{#if tokenDisposition.locked}}disabled aria-describedby="{{controlId}}-token-overrides"{{/if}}>
              {{#each tokenDisposition.options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
        </div>
        {{#if hasTokenOverrides}}
        <p id="{{controlId}}-token-overrides" class="hint">{{localize "FBL_CF.Forge.TokenWorldOverrides"}}</p>
        {{/if}}
      </div>
    </details>

    <details class="fbl-cf-disclosure" data-section="batch" {{#if expanded.batch}}open{{/if}}>
      <summary><span><i class="fas fa-layer-group"></i> {{localize "FBL_CF.Forge.Batch"}}</span><i class="fas fa-chevron-down fbl-cf-disclosure__chevron"></i></summary>
      <div class="fbl-cf-disclosure__body fbl-cf-batch-row">
        <div class="form-group stacked">
          <label for="{{controlId}}-batchCount">{{localize "FBL_CF.Forge.BatchCount"}}</label>
          <input id="{{controlId}}-batchCount" type="number" name="batchCount" min="2" max="100" value="{{state.batchCount}}">
        </div>
        <button type="button" data-action="create-batch"><i class="fas fa-users"></i> {{localize "FBL_CF.Forge.CreateBatch"}}</button>
        <p class="hint">{{localize "FBL_CF.Forge.BatchHint"}}</p>
      </div>
    </details>

    <details class="fbl-cf-disclosure" data-section="history" {{#if expanded.history}}open{{/if}}>
      <summary><span><i class="fas fa-clock-rotate-left"></i> {{localize "FBL_CF.Forge.History"}}</span><i class="fas fa-chevron-down fbl-cf-disclosure__chevron"></i></summary>
      <div class="fbl-cf-disclosure__body">
        {{#if historyAvailable}}
        <div class="fbl-cf-history-head">
          <span></span>
          <button type="button" class="fbl-cf-icon-button" data-action="clear-history" data-tooltip="{{localize 'FBL_CF.Forge.ClearHistory'}}" aria-label="{{localize 'FBL_CF.Forge.ClearHistory'}}"><i class="fas fa-trash"></i></button>
        </div>
        <ol class="fbl-cf-history">
          {{#each history}}
          <li>
            {{#if portrait}}<img src="{{portrait}}" alt="">{{/if}}
            <span><strong>{{name}}</strong><small>{{timestampLabel}}</small></span>
          </li>
          {{/each}}
        </ol>
        {{else}}<p class="hint">{{localize "FBL_CF.Forge.HistoryEmpty"}}</p>{{/if}}
      </div>
    </details>
  </div>

  <footer class="fbl-cf-forge__footer">
    <button type="button" class="fbl-cf-cancel" data-action="close" {{#if busy}}disabled{{/if}}><i class="fas fa-xmark"></i> {{localize "FBL_CF.Common.Cancel"}}</button>
    <div class="fbl-cf-footer-actions" {{#if busy}}inert{{/if}}>
      <button type="button" data-action="create-open"><i class="fas fa-up-right-from-square"></i> {{localize "FBL_CF.Forge.CreateOpen"}}</button>
      <button type="button" data-action="create-continue"><i class="fas fa-forward"></i> {{localize "FBL_CF.Forge.CreateContinue"}}</button>
      <button type="button" class="fbl-cf-primary" data-action="create"><i class="fas fa-user-plus"></i> {{localize "FBL_CF.Forge.Create"}}</button>
    </div>
  </footer>
</div>
